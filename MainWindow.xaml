<Window
    x:Class="ApexLegendsVoiceSwitcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Apex Legends Voice Switcher">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏：保留原生窗口按钮，同时让内容与 Mica 融合。 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="24" Height="24" CornerRadius="6" Background="{ThemeResource AccentFillColorDefaultBrush}">
                <FontIcon Glyph="&#xE995;" FontSize="14" Foreground="White" />
            </Border>
            <TextBlock Grid.Column="1" Text="Apex Legends Voice Switcher"
                       VerticalAlignment="Center" FontWeight="SemiBold" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="960" Padding="40,24,40,48" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Hero -->
                <Grid Padding="4,8,4,24" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="为 Apex 选择你喜欢的声音"
                                   Style="{StaticResource TitleTextBlockStyle}" FontSize="32" />
                        <TextBlock Text="界面文字保持不变，只切换官方角色语音。"
                                   Style="{StaticResource SubtitleTextBlockStyle}" Opacity="0.72" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="88" Height="88" CornerRadius="24"
                            Background="{ThemeResource AccentFillColorSecondaryBrush}">
                        <FontIcon Glyph="&#xE8D6;" FontSize="42"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                </Grid>

                <!-- 语音选择卡片 -->
                <Border Grid.Row="1" Padding="24" CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="10"
                                Background="{ThemeResource AccentFillColorTertiaryBrush}">
                            <FontIcon Glyph="&#xE767;" FontSize="20" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="语音语言" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="选择后会生成对应的 Steam 启动项" Opacity="0.62" />
                            </StackPanel>
                            <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch"
                                      SelectionChanged="Language_Changed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 路径设置 -->
                <StackPanel Grid.Row="2" Margin="0,24,0,0" Spacing="8">
                    <TextBlock Text="存储位置" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="4,0,0,4" />
                    <Border Padding="20" CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7FC;" FontSize="20" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Apex Legends" FontWeight="SemiBold" />
                                <TextBlock Text="游戏安装目录" FontSize="12" Opacity="0.58" />
                            </StackPanel>
                            <TextBox x:Name="GamePathBox" Grid.Column="2" VerticalAlignment="Center"
                                     PlaceholderText="选择 Apex Legends 目录" />
                            <Button Grid.Column="3" Content="浏览…" Click="BrowseGame_Click" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Padding="20" CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE896;" FontSize="20" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="SteamCMD" FontWeight="SemiBold" />
                                <TextBlock Text="语言 Depot 缓存" FontSize="12" Opacity="0.58" />
                            </StackPanel>
                            <TextBox x:Name="SteamCmdPathBox" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center"
                                     IsReadOnly="True" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 登录与安装 -->
                <StackPanel Grid.Row="3" Margin="0,24,0,0" Spacing="12">
                    <TextBlock Text="下载与安装" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="4,0,0,0" />
                    <InfoBar IsOpen="True" Severity="Informational" IsIconVisible="True"
                             Title="需要 Steam 账号"
                             Message="Apex Depot 不允许匿名下载。密码和 Steam Guard 只在 SteamCMD 窗口输入，本工具不会读取或保存。" />
                    <Border Padding="20" CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="UsernameBox" Header="Steam 用户名"
                                     PlaceholderText="用于打开 SteamCMD 登录" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                <Button x:Name="RemoveButton" Content="删除当前语音" Click="Remove_Click" />
                                <Button x:Name="InstallButton" MinWidth="190"
                                        Content="下载并安装语音" Style="{StaticResource AccentButtonStyle}"
                                        Click="Install_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <InfoBar x:Name="StatusBar" IsOpen="True" Severity="Informational" Title="准备检查" />
                    <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />
                </StackPanel>

                <!-- 启动项 -->
                <Border Grid.Row="4" Margin="0,24,0,0" Padding="24" CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE756;" FontSize="22" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="7">
                            <TextBlock Text="Steam 启动项" FontWeight="SemiBold" />
                            <TextBox x:Name="LaunchOptionBox" IsReadOnly="True" FontFamily="Consolas" />
                            <TextBlock Text="Steam → Apex Legends → 属性 → 通用 → 启动选项"
                                       FontSize="12" Opacity="0.58" />
                        </StackPanel>
                        <Button Grid.Column="2" Click="CopyLaunchOption_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock Text="复制" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
