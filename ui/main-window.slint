import { Button, ComboBox, LineEdit, ProgressIndicator, ScrollView, TextEdit } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Apex Legends Voice Switcher";
    preferred-width: 820px;
    preferred-height: 700px;
    min-width: 720px;
    max-width: 820px;
    min-height: 680px;
    max-height: 700px;
    background: #0f141c;
    default-font-family: "Microsoft YaHei UI";

    in-out property <string> game-path;
    in property <string> steamcmd-path;
    in-out property <string> username;
    in property <[string]> languages;
    in-out property <int> selected-language: 3;
    in property <string> launch-option;
    in property <string> status-title: "准备检查";
    in property <string> status-message;
    in property <string> install-label: "下载并安装语音";
    in property <bool> busy: false;
    in property <string> steamcmd-output: "SteamCMD 输出将在下载时显示。";
    in property <bool> steamcmd-active: false;

    // Modal dialog properties
    in property <bool> modal-visible: false;
    in property <string> modal-title: "";
    in property <string> modal-message: "";
    in property <bool> modal-is-danger: false;
    in property <string> modal-primary-text: "确认";
    in property <string> modal-secondary-text: "";
    in property <string> modal-cancel-text: "取消";

    callback browse();
    callback language-changed(int);
    callback copy-launch-option();
    callback install();
    callback remove();
    callback steamcmd-submit(string);
    callback steamcmd-cancel();

    // Modal dialog callbacks
    callback modal-primary-clicked();
    callback modal-secondary-clicked();
    callback modal-cancel-clicked();

    Rectangle {
        left-panel := Rectangle {
            x: 20px;
            y: 20px;
            width: (root.width - 56px) * 0.62;
            height: root.height - 40px;
            clip: true;

            VerticalLayout {
                width: parent.width;
                height: parent.height;
                spacing: 14px;

        // 头部：标题与应用概述
        VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Rectangle {
                    width: 4px;
                    height: 22px;
                    background: #da292a;
                    border-radius: 2px;
                }
                Text {
                    text: "Apex Legends 语音包切换器";
                    font-size: 20px;
                    font-weight: 700;
                    color: #f8fafc;
                    vertical-alignment: center;
                }
            }
            Text {
                text: "保留 Steam 界面原有文本语言，在游戏音频目录中安装与切换官方角色语音包。";
                font-size: 13px;
                color: #94a3b8;
            }
        }

        // 主体区域：统一面板
        ScrollView {
            width: parent.width;
            VerticalLayout {
                spacing: 12px;

                Rectangle {
                    background: #151b26;
                    border-color: #243042;
                    border-width: 1px;
                    border-radius: 10px;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 16px;

                        // 区域 1：语音选择与主要操作
                        VerticalLayout {
                            spacing: 12px;

                            Text {
                                text: "语音配置与安装";
                                font-size: 16px;
                                font-weight: 700;
                                color: #f1f5f9;
                            }

                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: "目标语音语言";
                                    font-size: 14px;
                                    color: #cbd5e1;
                                }
                                ComboBox {
                                    min-width: 0px;
                                    model: root.languages;
                                    current-index <=> root.selected-language;
                                    enabled: !root.busy && !root.modal-visible;
                                    selected(value) => { root.language-changed(self.current-index); }
                                }
                            }

                            Text {
                                text: "说明：点击下载后，请在右侧提交 Steam 密码及 Steam Guard 验证码。";
                                font-size: 13px;
                                color: #94a3b8;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;

                                Button {
                                    text: root.install-label;
                                    primary: true;
                                    enabled: !root.busy && !root.modal-visible;
                                    clicked => { root.install(); }
                                }

                                Button {
                                    text: "删除当前语音";
                                    enabled: !root.busy && !root.modal-visible;
                                    clicked => { root.remove(); }
                                }
                            }
                        }

                        // 分隔线
                        Rectangle {
                            height: 1px;
                            background: #222d3e;
                        }

                        // 区域 2：Steam 启动项
                        VerticalLayout {
                            spacing: 8px;

                            Text {
                                text: "Steam 启动项";
                                font-size: 16px;
                                font-weight: 700;
                                color: #f1f5f9;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                Rectangle {
                                    background: #0c1017;
                                    border-color: #243042;
                                    border-width: 1px;
                                    border-radius: 6px;
                                    height: 40px;
                                    horizontal-stretch: 1;

                                    Text {
                                        x: 12px;
                                        width: parent.width - 24px;
                                        text: root.launch-option;
                                        font-family: "Consolas";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: #38bdf8;
                                        vertical-alignment: center;
                                    }
                                }

                                Button {
                                    text: "复制启动项";
                                    enabled: !root.busy && !root.modal-visible;
                                    clicked => { root.copy-launch-option(); }
                                }
                            }

                            Text {
                                text: "提示：在 Steam 库中右键 Apex Legends → 属性 → 通用 → 启动选项 中填入该参数即可生效。";
                                font-size: 13px;
                                color: #94a3b8;
                                wrap: word-wrap;
                            }
                        }

                        // 分隔线
                        Rectangle {
                            height: 1px;
                            background: #222d3e;
                        }

                        // 区域 3：路径与运行环境
                        VerticalLayout {
                            spacing: 10px;

                            Text {
                                text: "游戏路径与环境";
                                font-size: 16px;
                                font-weight: 700;
                                color: #f1f5f9;
                            }

                            Text {
                                text: "Apex Legends 游戏安装目录 (包含 audio\\ship)";
                                font-size: 14px;
                                color: #cbd5e1;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                LineEdit {
                                    min-width: 0px;
                                    text <=> root.game-path;
                                    enabled: !root.busy && !root.modal-visible;
                                    placeholder-text: "请选择游戏根目录 (如 SteamLibrary\\steamapps\\common\\Apex Legends)";
                                }

                                Button {
                                    text: "浏览…";
                                    enabled: !root.busy && !root.modal-visible;
                                    clicked => { root.browse(); }
                                }
                            }

                            Text {
                                text: "SteamCMD 缓存目录：" + root.steamcmd-path;
                                font-size: 13px;
                                color: #94a3b8;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }

        // 底部固定状态栏
        Rectangle {
            background: #121822;
            border-color: #202a3a;
            border-width: 1px;
            border-radius: 8px;
            min-height: 72px;

            HorizontalLayout {
                Rectangle {
                    width: 4px;
                    background: root.busy ? #f59e0b : #38bdf8;
                    border-radius: 2px;
                }

                VerticalLayout {
                    padding-top: 10px;
                    padding-bottom: 10px;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 4px;

                    Text {
                        text: root.status-title;
                        font-size: 14px;
                        font-weight: 700;
                        color: root.busy ? #f59e0b : #38bdf8;
                    }

                    Text {
                        text: root.status-message;
                        font-size: 13px;
                        color: #cbd5e1;
                        wrap: word-wrap;
                    }

                    if root.busy: ProgressIndicator {
                        indeterminate: true;
                    }
                }
            }
        }
        }
        }

        Rectangle {
            x: left-panel.x + left-panel.width + 16px;
            y: 20px;
            width: root.width - self.x - 20px;
            height: root.height - 40px;
            background: #0b1017;
            border-color: #243042;
            border-width: 1px;
            border-radius: 10px;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        width: 4px;
                        height: 20px;
                        background: root.steamcmd-active ? #f59e0b : #38bdf8;
                        border-radius: 2px;
                    }
                    Text {
                        text: "SteamCMD";
                        font-size: 17px;
                        font-weight: 700;
                        color: #f8fafc;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: root.steamcmd-active ? "等待登录 · 请在下方提交密码或 Steam Guard 验证码" : "待机 · 下载时将在此处显示 SteamCMD 输出";
                    font-size: 12px;
                    color: root.steamcmd-active ? #f59e0b : #94a3b8;
                    wrap: word-wrap;
                }

                TextEdit {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    text: root.steamcmd-output;
                    read-only: true;
                    enabled: true;
                    wrap: word-wrap;
                    font-family: "Consolas";
                    font-size: 12px;
                }

                Text {
                    text: "Steam 用户名";
                    font-size: 13px;
                    font-weight: 600;
                    color: #cbd5e1;
                }

                LineEdit {
                    text <=> root.username;
                    placeholder-text: "已入库 Apex 的 Steam 用户名";
                    enabled: !root.busy && !root.modal-visible;
                }

                Text {
                    text: "密码 / Steam Guard";
                    font-size: 13px;
                    font-weight: 600;
                    color: #cbd5e1;
                }

                secure-input := LineEdit {
                    input-type: InputType.password;
                    placeholder-text: root.steamcmd-active ? "输入密码或 Steam Guard 验证码后按回车" : "SteamCMD 未运行";
                    enabled: root.steamcmd-active;
                    accepted => {
                        if self.text != "" {
                            root.steamcmd-submit(self.text);
                            self.text = "";
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "提交";
                        primary: true;
                        enabled: root.steamcmd-active && secure-input.text != "";
                        clicked => {
                            root.steamcmd-submit(secure-input.text);
                            secure-input.text = "";
                        }
                    }
                    Button {
                        text: "取消 SteamCMD";
                        enabled: root.steamcmd-active;
                        clicked => { root.steamcmd-cancel(); }
                    }
                }

                Text {
                    text: "安全输入只会写入当前 SteamCMD 进程，不会加入右侧日志或保存到磁盘。";
                    font-size: 11px;
                    color: #64748b;
                    wrap: word-wrap;
                }
            }
        }
    }

    // 自定义应用内模态弹窗遮罩
    if root.modal-visible: Rectangle {
        background: #000000bd;

        TouchArea {
            // 拦截所有穿透点击
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 480px;
            height: 210px;
            background: #171e2c;
            border-color: root.modal-is-danger ? #dc2626 : #334155;
            border-width: 1px;
            border-radius: 10px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000099;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        width: 4px;
                        height: 20px;
                        background: root.modal-is-danger ? #ef4444 : #38bdf8;
                        border-radius: 2px;
                    }
                    Text {
                        text: root.modal-title;
                        font-size: 17px;
                        font-weight: 700;
                        color: #f8fafc;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: root.modal-message;
                    font-size: 14px;
                    color: #cbd5e1;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    height: 38px;
                    spacing: 10px;
                    alignment: end;

                    if root.modal-cancel-text != "": Button {
                        text: root.modal-cancel-text;
                        clicked => { root.modal-cancel-clicked(); }
                    }

                    if root.modal-secondary-text != "": Button {
                        text: root.modal-secondary-text;
                        clicked => { root.modal-secondary-clicked(); }
                    }

                    if root.modal-primary-text != "": Button {
                        text: root.modal-primary-text;
                        primary: true;
                        clicked => { root.modal-primary-clicked(); }
                    }
                }
            }
        }
    }
}
